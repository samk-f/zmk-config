# Dongle central for the Corne. Pair with the stock corne_left (built with
# -DCONFIG_ZMK_SPLIT_ROLE_CENTRAL=n) and corne_right shields.
if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

config ZMK_BLE
    default y

endif
